# ============================================================
# Octane Podcast — конфигурация
# Скопируй этот файл в .env и заполни значения.
# В GitHub эти же значения задаются как Secrets (см. README).
# ============================================================

# --- Где публикуется подкаст (публичный базовый URL) ---
# Если хостишь на GitHub Pages: https://<username>.github.io/<repo>
# ВАЖНО: без слэша в конце.
PUBLIC_BASE_URL=https://YOURNAME.github.io/octane-podcast

# --- Данные подкаста (для RSS / YouTube Music) ---
PODCAST_TITLE=Octane Rent — Daily Supercar
PODCAST_AUTHOR=Octane Rent
PODCAST_EMAIL=bpe@octaneluxurycarrental.com
PODCAST_DESCRIPTION=Every day one exotic car from Octane Rent — specs, price and the vibe. Dubai, Abu Dhabi, Sharjah, Miami.
PODCAST_LANGUAGE=en
PODCAST_CATEGORY=Leisure
PODCAST_SITE=https://octane.rent

# --- Движок сценария (LLM) ---
# provider: openrouter | groq | openai | anthropic | gemini | none
# openrouter — бесплатно, без карты, работает из СНГ. Ключ: openrouter.ai/keys
SCRIPT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Запасной вариант: Groq (если доступен в твоём регионе) ---
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Прочие провайдеры (не обязательно) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Озвучка ---
# tts_provider: polly | ttsmp3
TTS_PROVIDER=polly

# AWS Polly (нужны, если TTS_PROVIDER=polly)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Голоса по ролям (neural-голоса Polly). A=ведущий, B=ведущая, G=гость, E=эксперт Дарья.
# Гостю можно ставить разные акценты (Brian=UK, Amy=UK, Kajal=IN-EN, Arlet=... и т.д.)
POLLY_VOICE_A=Matthew
POLLY_VOICE_B=Joanna
POLLY_VOICE_G=Brian
POLLY_VOICE_E=Ruth
POLLY_ENGINE=neural

# ttsmp3.com (нужно, если TTS_PROVIDER=ttsmp3; требуется платный API-ключ)
# TTSMP3_API_KEY=
# TTSMP3_VOICE_A=Matthew
# TTSMP3_VOICE_B=Joanna

# --- Видео (заставка + фото + вшитые субтитры) ---
VIDEO_ENABLED=true
INTRO_SECONDS=3

# --- Загрузка на YouTube (твой канал) ---
# Включи, когда получишь refresh-токен (см. README «Привязка YouTube-канала»)
YOUTUBE_ENABLED=false
YOUTUBE_PRIVACY=private          # сначала private для проверки, потом public
YOUTUBE_CATEGORY_ID=2            # 2 = Autos & Vehicles
YOUTUBE_UPLOAD_CAPTIONS=true
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- RSS для YouTube Music (можно оставить параллельно с видео) ---
RSS_ENABLED=true

# --- Прочее ---
# Сколько машин обрабатывать за один запуск (обычно 1)
CARS_PER_RUN=1
# Регэксп: какие URL из sitemap считать страницами моделей авто
CAR_URL_PATTERN=(cars|car-rental|for-rent|suv|sports|luxury|convertible|sedan|coupe|premium)
